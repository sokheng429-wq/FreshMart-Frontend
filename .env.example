# ==============================================================================
# B'Groceries Frontend - Environment Variables Configuration
# ==============================================================================
# For local development:
#   Copy this file to `.env` or `.env.local`
#
# For Cloudflare Pages production deployment:
#   Set these environment variables in your Cloudflare Dashboard under:
#   Workers & Pages > b-groceries-frontend > Settings > Environment variables
# ==============================================================================

# Public URL of your Spring Boot backend API (including `/api`)
# Default fallback: http://localhost:8081/api
VITE_API_BASE_URL=http://localhost:8081/api

# Public base URL of your Spring Boot backend (without trailing slash or `/api`)
# Used for OAuth redirects and image asset URLs.
# Default fallback: http://localhost:8081
VITE_BACKEND_URL=http://localhost:8081

# Google OAuth2 Client ID (from Google Cloud Console)
# Ensure your Cloudflare Pages domain (e.g., https://<project>.pages.dev) is added
# to "Authorized JavaScript origins" and "Authorized redirect URIs" in Google Console.
VITE_GOOGLE_CLIENT_ID=

# Telegram Bot username for Telegram login (without @)
VITE_TELEGRAM_BOT_USERNAME=FreshMartBot
